# 이 파일을 .env.local로 복사해 값을 채웁니다. .env*는 커밋되지 않습니다.
# Vercel에는 Settings → Environment Variables에 같은 이름으로 넣습니다.

# Claude API — 서버 전용
ANTHROPIC_API_KEY=sk-ant-...

# 채점 설정. 비워두면 claude-opus-5 · low 입니다 (docs/13 §13.15 실측).
# **결과가 신통치 않으면 코드를 안 고치고 여기만 되돌립니다.**
#   GRADING_EFFORT=high   ← 예전 설정으로 복귀
# GRADING_MODEL=claude-opus-5
# GRADING_EFFORT=low
#
# 🔴 GRADING_MODEL은 **Anthropic 모델만** 받습니다. 여기에 gpt-를 넣으면 앱이
# 뜨지 않습니다 — 실제 채점이 동의서에 없는 회사로 나가는 것을 막는 선입니다
# (docs/14 §14.3의 국외 이전 대상은 Anthropic PBC 하나).

# OpenAI API — 서버 전용. **/bench 모델 비교 실험에서만** 씁니다.
# 없어도 앱은 정상 동작하고, GPT를 고른 실험만 "키가 없다"고 실패합니다.
# 🔴 이 키를 넣는다고 채점이 GPT로 넘어가지는 않습니다. 다만 실험을 돌리면
#    학생 답안지 사진이 OpenAI로 나갑니다 — 동의서를 돌리기 전에 끝내십시오.
# OPENAI_API_KEY=sk-...

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 🔴 서버 전용. RLS를 통째로 우회합니다.
# 90일 지난 사진을 지우는 정리 작업에서만 씁니다 (supabase/README.md).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 도메인을 붙인 뒤에 넣습니다. 넣으면 옛 vercel.app 주소로 들어와도 여기로 넘깁니다.
# 🔴 **DNS가 확인되기 전에 넣지 마십시오** — 아무 데도 못 가게 됩니다.
# CANONICAL_HOST=gradesnap.yussam.com

# 🔴 서버 전용. 매일 도는 사진 정리(/api/retention)를 Vercel Cron만 부를 수 있게 막습니다.
# Vercel이 크론 요청에 `Authorization: Bearer <이 값>`을 붙여 보냅니다.
# 아무 긴 무작위 문자열이면 됩니다. 비워두면 자동 실행이 401로 막힙니다.
CRON_SECRET=
