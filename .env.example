# 이 파일을 .env.local로 복사해 값을 채웁니다. .env*는 커밋되지 않습니다.
# Vercel에는 Settings → Environment Variables에 같은 이름으로 넣습니다.

# Claude API — 서버 전용
ANTHROPIC_API_KEY=sk-ant-...

# 채점 모델은 **더 이상 환경 변수가 아닙니다.**
#   GradeSnap 관리 화면 → 채점 모델
# 예전의 GRADING_MODEL / GRADING_EFFORT는 안 읽습니다. Vercel에 남아 있어도
# 아무 일도 안 합니다 — 지우셔도 됩니다.
# 옮긴 이유: 되돌리려면 재배포해야 했고, 서버만 아는 값이라 조교 화면이
# 지금 무엇으로 채점되는지 말할 수가 없었습니다 (docs/13 §13.20).

# OpenAI API — 서버 전용. **/bench 모델 비교 실험에서만** 씁니다.
# 없어도 앱은 정상 동작하고, GPT를 고른 실험만 "키가 없다"고 실패합니다.
# 🔴 이 키를 넣는다고 채점이 GPT로 넘어가지는 않습니다. 다만 실험을 돌리면
#    학생 답안지 사진이 OpenAI로 나갑니다 — 동의서를 돌리기 전에 끝내십시오.
# OPENAI_API_KEY=sk-...

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 🔴 서버 전용. RLS를 통째로 우회합니다.
# 90일 지난 사진을 지우는 정리 작업에서만 씁니다 (supabase/README.md).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 도메인을 붙인 뒤에 넣습니다. 넣으면 옛 vercel.app 주소로 들어와도 여기로 넘깁니다.
# 🔴 **DNS가 확인되기 전에 넣지 마십시오** — 아무 데도 못 가게 됩니다.
# CANONICAL_HOST=gradesnap.yussam.com

# 🔴 서버 전용. 매일 도는 사진 정리(/api/retention)를 Vercel Cron만 부를 수 있게 막습니다.
# Vercel이 크론 요청에 `Authorization: Bearer <이 값>`을 붙여 보냅니다.
# 아무 긴 무작위 문자열이면 됩니다. 비워두면 자동 실행이 401로 막힙니다.
CRON_SECRET=

# ---------------------------------------------------------------------------
# 구글 드라이브 — 선생님들이 올리는 정답지를 읽어옵니다 (docs/17)
# ---------------------------------------------------------------------------
# 셋을 **다 넣어야** 켜집니다. 하나라도 비면 이 기능만 조용히 꺼지고,
# 정답지를 사진으로 올리는 길은 그대로 있습니다.
#
# 만드는 절차는 docs/17-google-drive.md에 화면 단위로 적혀 있습니다.

# 서비스 계정 주소. 이 주소를 정답지 폴더에 **보기 권한으로 공유**합니다.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=gradesnap-drive@....iam.gserviceaccount.com

# 🔴 서버 전용. **개인 열쇠**입니다 — 브라우저에 나가면 그 폴더를 아무나 읽습니다.
# JSON 파일 안의 private_key 값을 통째로 붙여 넣습니다. 줄바꿈은 \n 그대로 둡니다.
# NEXT_PUBLIC_ 접두사를 붙이지 마십시오.
# GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# 정답지 상위 폴더의 ID. 구글 폴더 주소에서 /folders/ 뒤의 긴 문자열입니다.
#   https://drive.google.com/drive/folders/1L6j425t9iL7V4caJEi9_zNHPNI9-CJ-G
#                                          └──────────── 이 부분 ────────────┘
# DRIVE_FOLDER_ID=
