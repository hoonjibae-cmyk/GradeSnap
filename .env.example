# 이 파일을 .env.local로 복사해 값을 채웁니다. .env*는 커밋되지 않습니다.
# Vercel에는 Settings → Environment Variables에 같은 이름으로 넣습니다.

# Claude API — 서버 전용
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 🔴 서버 전용. RLS를 통째로 우회합니다.
# 90일 지난 사진을 지우는 정리 작업에서만 씁니다 (supabase/README.md).
SUPABASE_SERVICE_ROLE_KEY=eyJ...
